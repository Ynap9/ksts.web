# Chép thành .env rồi điền giá trị thật. KHÔNG commit .env.

APP_ENV=latest
HOST_PORT=8200
ASPNETCORE_ENVIRONMENT=Production

# Dấu __ là cách ASP.NET Core lồng khoá cấu hình, đè lên appsettings.json.
ConnectionStrings__KY_SO_SAO_MAI=Data Source=<host>,1433;Initial Catalog=KY_SO_SAO_MAI;User Id=<user>;Password=<password>;TrustServerCertificate=True;MultipleActiveResultSets=True;
ConnectionStrings__MongoDb=mongodb://<host>:27017/<db>?directConnection=true&serverSelectionTimeoutMS=2000

S3__S3_URL=http://<host>:9000
S3__S3_REGION=us-east-1
S3__S3_BUCKET=<bucket>
S3__S3_ACCESS_KEY=<access-key>
S3__S3_SECRET_KEY=<secret-key>

# Để trống thì lô ký xong chỉ ghi log cảnh báo, không gọi ngược sao_mai_be.
SaoMai__CallbackUrl=
SaoMai__CallbackApiKey=
SaoMai__CallbackTimeoutSeconds=30
